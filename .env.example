# ─────────────────────────────────────────────────────────────────────────────
# Configuración del ejemplo de verificación (front + BFF).
#
# TODA la configuración es de ejecución (runtime). La MISMA imagen Docker sirve para
# cualquier despliegue: solo cambia este archivo.
#   cp .env.example .env      # completa los valores
#   npm run dev               # o: docker run --env-file .env ...
#
# IMPORTANTE: en Docker todo lo que sigue a `=` es el valor; deja cada comentario en su
# propia línea. Nunca subas el `.env` real (contiene la clave de la cuenta de servicio).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1) Verificación: QUÉ regla se ejecuta y contra qué backend ───────────────────

# Base del API de verificación de Blerify.
BLERIFY_API_URL=https://api.blerify.com

# Organización verificadora. REQUERIDO.
ORG_ID=

# Proyecto. REQUERIDO.
PROJECT_ID=

# Id de la regla de verificación (PresentationVerification publicada / ACTIVE). REQUERIDO.
RULE_ID=

# Base del deep link que abre la wallet al escanear el QR (o al pulsar el botón en móvil).
WALLET_BASE_URL=https://wallet.blerify.com/production/

# ── 2) Cuenta de servicio: REQUERIDA para el flujo real (v2) ─────────────────────
# El BFF inicia y consulta la verificación con un token OAuth2 private_key_jwt (RFC 7523),
# aserción firmada RS256 (clave privada RSA-2048 en PKCS#8 PEM). Sin esto solo funciona DEMO_MOCK.

# client_id de la cuenta de servicio. REQUERIDO (v2).
SA_CLIENT_ID=

# Clave privada PKCS#8 PEM (RSA-2048), en UNA sola línea con \n literales. REQUERIDO (v2).
#   SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
SA_PRIVATE_KEY=

# Audiencia IAM, p.ej. https://iam.blerify.com/realms/{orgId}. REQUERIDO (v2).
SA_IAM_AUDIENCE=

# Opcional: endpoint del token. Default ${BLERIFY_API_URL}/auth/v2/protocol/openid-connect/token
# SA_TOKEN_URI=

# Opcional: organización de la cuenta de servicio. Default = ORG_ID
# SA_ORGANIZATION_ID=

# ── 3) Servicio ──────────────────────────────────────────────────────────────────

# Puerto de escucha.
PORT=8080

# ── 4) Modo demostración sin backend (opcional) ──────────────────────────────────
# DEMO_MOCK=true simula el flujo completo SIN llamar a Blerify ni requerir cuenta de servicio.
# Útil para probar la interfaz antes de tener una regla / credenciales reales.
# DEMO_MOCK=true

# Milisegundos que "tarda" la wallet simulada (solo en modo mock).
# DEMO_MOCK_DELAY_MS=5000
